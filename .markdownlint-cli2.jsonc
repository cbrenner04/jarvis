{
  "globs": [
    "v1/spec/**/*.md",
    "v1/docs/**/*.md",
    "reports/**/*.md",
    "v2/docs/**/*.md",
    "v2/spec/**/*.md",
    "README.md",
    "AGENTS.md"
  ],
  "ignores": ["**/completed/**", "**/node_modules/**", "**/verdict-*.md"],
  "config": {
    "default": true,
    // Unordered/ordered list markers: inconsistent marker usage across corpus (pervasive house style)
    "MD009": false,
    // Line length: specs and docs contain long URLs, tables, and code inline; normalizing would require corpus reflow (out of scope)
    "MD013": false,
    // Code block spacing: blank lines before/after code blocks are inconsistent across corpus
    "MD031": false,
    // Fenced code blocks: indentation and markers vary per-section; enforcing would require corpus normalization
    "MD032": false,
    // Inline HTML: docs use inline <...> tags; widespread and intentional
    "MD033": false,
    // Fenced code block language: many code blocks lack language identifiers; enforcing would require corpus reflow
    "MD040": false,
    // Ordered list item prefix: corpus has intentional numbered lists that don't follow 1/2/3 pattern
    "MD029": false,
    // Multiple headings with the same content: docs reuse heading names across distinct sections
    "MD024": false,
    // Link fragments: anchor references vary by context; some fragments reference non-heading content
    "MD051": false
  }
}
