{
  "name": "jarvis",
  "version": "0.0.0",
  "module": "src/cli.ts",
  "type": "module",
  "private": true,
  "bin": {
    "jarvis": "bin/jarvis"
  },
  "scripts": {
    "check": "bun biome check . && bun run scripts/guard-sync-child-processes.ts && bun run scripts/guard-production-test-support-imports.ts && bun run scripts/guard-dead-exports.ts && bun run scripts/guard-deterministic-daemon-tests.ts && bun run scripts/guard-test-double-production-calls.ts && bun run scripts/guard-production-test-flags.ts && bun run scripts/guard-lossless-git-status-inventory.ts && bun run scripts/guard-unbounded-subprocess.ts && bun run scripts/guard-real-lint-in-unit-tests.ts && bun run scripts/guard-test-temp-dir-cleanup.ts && bun run scripts/guard-git-spawn-bypass.ts && bun run scripts/guard-operator-doc-v2-language.ts",
    "check:fix": "bun biome check --write .",
    "check:fix:unsafe": "bun biome check --write --unsafe .",
    "fix": "bun run check:fix:unsafe",
    "format": "bun biome format --write .",
    "format:check": "bun biome format .",
    "lint": "bun biome lint .",
    "lint:fix": "bun biome lint --write .",
    "lint:fix:unsafe": "bun biome lint --write --unsafe .",
    "lint:md": "bun node_modules/markdownlint-cli2/markdownlint-cli2.js",
    "reflow:md": "bun scripts/reflow-markdown.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "install-opencode-permissions": "bun run scripts/install-opencode-permissions.ts",
    "test": "bun run scripts/run-tests.ts",
    "test:confirm:live": "bun run scripts/run-tests.ts --serial",
    "test:cost": "bun run scripts/measure-test-cost.ts",
    "test:agent": "bun run scripts/run-slice-tests.ts agent",
    "test:integration": "bun run scripts/run-slice-tests.ts integration",
    "coverage": "bun test --coverage ./src/ ./test/",
    "coverage:src": "bun test --coverage ./src/",
    "coverage:shared": "bun test --coverage ./src/shared/ ./test/",
    "ready": "bun scripts/ready.ts",
    "start": "bun run src/cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "markdownlint-cli2": "^0.15.0",
    "typescript": "^5"
  },
  "dependencies": {
    "ink": "^7.1.0",
    "js-tiktoken": "^1.0.21",
    "react": "^19.2.7"
  }
}
