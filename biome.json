{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/build",
      "!**/coverage",
      "!**/.git",
      "!**/v1/test/fixtures",
      "!**/v2/test/fixtures"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "useIndexOf": {
          "fix": "none"
        }
      },
      "style": {
        "noNonNullAssertion": {
          "level": "warn",
          "fix": "none"
        }
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["v1/src/**/*.ts", "v1/test/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/v2/**"],
                    "message": "v1 code must not import from v2."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["v2/src/**/*.ts", "!v2/src/**/*.test.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 24
              }
            }
          },
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/v1/**"],
                    "message": "v2 code must not import from v1."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["shared/**/*.ts", "!shared/**/*.test.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 24
              }
            }
          },
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/v1/**"],
                    "message": "shared code must not import from v1."
                  },
                  {
                    "group": ["**/v2/**"],
                    "message": "shared code must not import from v2."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
