{
  "name": "jarvis",
  "version": "0.0.0",
  "module": "v1/src/index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "jarvis1": "bin/jarvis1",
    "jarvis": "bin/jarvis"
  },
  "scripts": {
    "check": "bun node_modules/@biomejs/biome/bin/biome check .",
    "check:fix": "bun node_modules/@biomejs/biome/bin/biome check --write .",
    "check:fix:unsafe": "bun node_modules/@biomejs/biome/bin/biome check --write --unsafe .",
    "format": "bun node_modules/@biomejs/biome/bin/biome format --write .",
    "format:check": "bun node_modules/@biomejs/biome/bin/biome format .",
    "lint": "bun node_modules/@biomejs/biome/bin/biome lint .",
    "lint:fix": "bun node_modules/@biomejs/biome/bin/biome lint --write .",
    "lint:fix:unsafe": "bun node_modules/@biomejs/biome/bin/biome lint --write --unsafe .",
    "lint:md": "bun node_modules/markdownlint-cli2/markdownlint-cli2.bin.mjs",
    "typecheck": "tsc --noEmit -p v1/tsconfig.json && tsc --noEmit -p v2/tsconfig.json && tsc --noEmit -p shared/tsconfig.json",
    "install-opencode-permissions": "bun run scripts/install-opencode-permissions.ts",
    "test": "bun test --parallel",
    "test:v1": "bun test ./v1/",
    "test:v2": "bun test ./v2/",
    "test:shared": "bun test ./shared/ ./test/",
    "coverage": "bun test --coverage",
    "coverage:v1": "bun test --coverage ./v1/",
    "coverage:v2": "bun test --coverage ./v2/",
    "coverage:shared": "bun test --coverage ./shared/ ./test/",
    "ready": "bun scripts/ready.ts",
    "start": "bun run v1/src/index.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/bun": "latest",
    "markdownlint-cli2": "^0.15.0",
    "typescript": "^5"
  },
  "dependencies": {
    "js-tiktoken": "^1.0.21"
  }
}
